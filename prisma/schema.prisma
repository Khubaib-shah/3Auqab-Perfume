// 3Uqab Perfume (Three Uqab) - Production PostgreSQL Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ORDER_MANAGER
  CONTENT_EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPER_ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model StoreSetting {
  id                    String   @id @default("default")
  brandName             String   @default("3Uqab Perfume")
  shortName             String   @default("3Uqab")
  fullName              String   @default("Three Uqab Perfume")
  tagline               String   @default("Luxury Arabian & French Eau de Parfum")
  description           String   @db.Text
  siteUrl               String   @default("https://3uqab.com")
  promoCode             String   @default("3UQAB")
  currencySymbol        String   @default("Rs")
  freeShippingThreshold Float    @default(5000)
  flatShippingRate      Float    @default(250)
  whatsappNumber        String   @default("923149784156")
  phone                 String   @default("(+92) 314 9784156")
  email                 String   @default("info@3uqab.com")
  address               String   @default("Perfume Souk Boulevard, Dubai, UAE & nationwide delivery")
  mapEmbedUrl           String   @db.Text
  facebookUrl           String?
  instagramUrl          String?
  twitterUrl            String?
  pinterestUrl          String?
  updatedAt             DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id         String   @id @default(cuid())
  styleClass String   @default("style4")
  subtitle   String
  titleLine1 String
  titleLine2 String
  priceLabel String?
  priceValue String?
  codeLabel  String?
  codeValue  String?
  btnClass   String   @default("btn-shop-the-look")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  showInNav   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  sku              String   @unique
  category         String
  price            Float
  oldPrice         Float?
  stockQuantity    Int      @default(25)
  inStock          Boolean  @default(true)
  isNew            Boolean  @default(true)
  isWeeklyFeatured Boolean  @default(true)
  rating           Float    @default(5)
  reviewsCount     Int      @default(12)
  image            String
  blackCardImage   String?
  orderThumb       String?
  cartThumb        String?
  gallery          String[]
  shortBullets     String[]
  description      String[]
  topNotes         String
  heartNotes       String
  baseNotes        String
  sizes            String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  firstName      String
  lastName       String
  email          String
  phone          String
  whatsapp       String?
  country        String
  state          String
  city           String
  zipCode        String?
  address        String        @db.Text
  subtotal       Float
  shippingCost   Float         @default(0)
  discountAmount Float         @default(0)
  totalAmount    Float
  paymentMethod  PaymentMethod @default(COD)
  paymentStatus  PaymentStatus @default(UNPAID)
  status         OrderStatus   @default(PENDING)
  courierName    String?
  trackingNumber String?
  trackingUrl    String?
  adminNotes     String?       @db.Text
  items          Json
  statusHistory  Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String
  date          String
  author        String
  authorRole    String
  authorAvatar  String
  views         Int      @default(0)
  commentsCount Int      @default(0)
  image         String
  sliderThumb   String?
  sidebarThumb  String?
  excerpt       String   @db.Text
  content       String[]
  quote         String   @db.Text
  tags          String[]
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  avatar    String
  text      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("Storefront")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
